generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum StoreType {
  COLLABORATOR
  OWNER
}

model User {
  id                   String    @id @default(cuid())
  name                 String? //store name
  firstName            String? // Owner's first name
  lastName             String? // Owner's last name
  email                String    @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  phoneNumber          String? 
  role                 Role      @default(ADMIN)
  accounts             Account[]
  sessions             Session[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  isDeleted            Boolean   @default(false)

  StoreCollaborator StoreUserRelation[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Product {
  id          String            @id @default(uuid())
  name        String            @db.VarChar(255)
  description String?           @db.Text
  price       Float
  imageUrl    String            @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  isDeleted   Boolean           @default(false)
  stock       Int?              @default(0)
  categories  ProductCategory[]
  orderItems  OrderItem[]

  storeId     String            
  store       Store             @relation(fields: [storeId], references: [id])
  @@index([storeId])
  @@index([isDeleted]) 
}

model Category {
  id               String             @id @default(uuid())
  name             String // Name of the category (e.g., "Clothing", "Mugs")
  type             CategoryType // Added enum to differentiate categories
  parentId         String? // Self-referencing to create hierarchy
  parentCategories CategoryRelation[] @relation("ChildToParent")
  childCategories  CategoryRelation[] @relation("ParentToChild")
  products         ProductCategory[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  isDeleted        Boolean            @default(false)

  // Explanation of the hierarchy:
  // - If parentId is null, this is a *Target Category* (top-level category).
  // - If parentId points to a Target Category, this is a *Product Category*.
  // - If parentId points to a Product Category, this is a *Subproduct Category*.
}

model CategoryRelation {
  parentId String
  childId  String
  parent   Category @relation("ParentToChild", fields: [parentId], references: [id])
  child    Category @relation("ChildToParent", fields: [childId], references: [id])

  @@id([parentId, childId])
}

enum CategoryType {
  TARGET // Top-level categories (Male, Female, All)
  PRODUCT // Mid-level categories (Clothing, Mugs)
  SUBPRODUCT // Low-level categories (T-shirts, Hoodies, Magic Mugs)
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId])
}

enum OrderStatus {
  CANCELED
  CONFIRMED
  PRINTED
  FULFILLED
  PAID
  PENDING
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

model Order {
  id             String         @id @default(uuid())
  storeId        String         @default("cm99m628c00008ugfbpm4y5y1")
  status         OrderStatus    @default(PENDING)
  totalPrice     Float
  shippingMethod ShippingMethod @default(STANDARD)
  shippingFee    Float
  items          OrderItem[]
  contactInfo    ContactInfo?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isDeleted      Boolean        @default(false)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  name      String
  imageUrl  String
}

model ContactInfo {
  id      String  @id @default(uuid())
  orderId String  @unique
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  phone   String
  email   String?
  country String  @default("Tunisia")
  address String
  city    String
}

model Store {
  id        String   @id @default(uuid())
  name      String   @unique
  url       String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  wallet    Wallet?
  Order     Order[]

  products  Product[]
  StoreCollaborator StoreUserRelation[]
}

model Wallet {
  id        String @id @default(uuid())
  storeId   String @unique
  Total     Float  @default(0)
  Delivered Float  @default(0)
  Returned  Float  @default(0)
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StoreUserRelation {
  storeId   String
  userId    String
  role      StoreType @default(COLLABORATOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
}
